#!/bin/bash
#SBATCH --partition=compute
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=12
#SBATCH --cpus-per-task=1
#SBATCH --time=01:00:00
#SBATCH --job-name=alat

export OMP_NUM_THREADS=1

module purge;module load intel-compilers/2021.2.0  impi/2021.2.0 QuantumESPRESSO/6.8 Python

SEED=`python id_to_seed.py $SLURM_ARRAY_TASK_ID`
mpirun -n 12 pw.x -in $SEED".pwi" >> $SEED".pwo"

rm $SEED"."save/wfc[1-4].hdf5

